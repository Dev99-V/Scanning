# Mẫu biến môi trường frontend — copy thành .env.local và điền key thật.
# Key thật chỉ nằm ở .env.local (gitignored) và GitHub Secrets (CI).
# KHÔNG bao giờ commit key thật, KHÔNG bao giờ dùng SERVICE_ROLE ở frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-key-here
